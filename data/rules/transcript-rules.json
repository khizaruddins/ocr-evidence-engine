      "min_val": 0.0,
      "max_val": 30.0,
      "confidence_boost": 0.10
    },
    "grade": {
      "valid_grades": ["A+", "A", "A-", "B+", "B", "B-", "C+", "C", "C-", "D+", "D", "D-", "F", "P", "NP", "S", "U", "W", "WP", "WF", "I", "IP", "CR", "NC", "AUD", "AU"],
      "confidence_boost": 0.15
    },
    "gpa": {
      "regex": "^[0-4](?:\\.[0-9]{1,3})?$",
      "min_val": 0.0,
      "max_val": 4.0,
      "confidence_boost": 0.15
    }
  },
