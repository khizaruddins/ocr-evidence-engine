{
  "document_type": "transcript",
  "version": "0.1.0",
  "field_patterns": {
    "course_code": {
      "regex": "^[A-Z]{2,5}\\s*[0-9]{2,4}[A-Z]?$",
      "description": "Alphanumeric course code with departmental prefix (e.g. ACCT 101, CS101, 22BS103, MATH2001)",
      "confidence_boost": 0.15
    },
    "credits": {
      "regex": "^[0-9]+(?:\\.[0-9]+)?$",
